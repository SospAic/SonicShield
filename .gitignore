.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
coverage/

# IDE
.idea/
*.iml
.vscode/
.trae/
*.ipr
*.iws

# Android
android/.gradle/
android/local.properties
android/key.properties
