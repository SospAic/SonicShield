<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== 声盾 SonicShield 权限声明（最小必要原则，见 docs/03/08） ===== -->

    <!-- 前台服务与类型（Android 14+ 要求逐类型声明对应权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 麦克风：守卫模式声音检测 / 录音取证 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 通知（Android 13+ 运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 精确闹钟：Doze 下可靠触发（Android 12+ 特殊权限，运行时引导） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 开机自启：恢复引擎（由 serviceShouldRun 标志控制） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 唤醒锁：执行播放期间保持 CPU -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 电池优化白名单（用户主动申请；Play 政策见 docs/08） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 音量/音频设置 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- TTS 服务查询 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!--
          flutter_background_service 的前台服务：mediaPlayback（定时播放）+
          dataSync（计划维护）。注意【不含 microphone】：Android 14+ 的
          while-in-use 语义下，服务被看门狗闹钟从后台复活时携带 microphone
          类型会被拒绝（SecurityException）。麦克风访问由本地插件的
          MicGuardService 在用户前台交互时独立持有（docs/05 §1.4）。
        -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="mediaPlayback|dataSync"
            tools:replace="android:foregroundServiceType" />

        <!-- 通道B：精确闹钟看门狗接收器已迁移至本地插件
             com.sonicshield.native_bridge.AlarmWatchdogReceiver -->
        <!-- 开机自启：仅在 serviceShouldRun 标志为真时恢复前台服务 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
